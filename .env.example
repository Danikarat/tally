# Environment ("development", "staging", "production")
ENV=development

# HTTP Server
PORT=8080
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=120s

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=tally
DB_PASSWORD=tally_secret
DB_NAME=tally_dev
DB_SSLMODE=disable

# Authentication
JWT_SECRET=dev-insecure-secret-change-in-production-min-32-chars
JWT_DURATION=24h
